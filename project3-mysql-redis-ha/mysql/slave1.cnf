[mysqld]
# ---- 复制标识：必须与 master(1) 和 slave2(3) 都不同 ----
# 从库之间 server-id 重复同样会导致复制失败，报错是
# "Fatal error: ... master and slave have equal MySQL server ids"
# 所以从库用的是两个独立的配置文件（slave1.cnf / slave2.cnf），而不是共用一个
server-id            = 2

# 从库也开 binlog + log_slave_updates：将来它被提升为新主库时，
# 其余从库才能以它为源继续复制
log-bin              = mysql-bin
binlog_format        = ROW
relay-log            = relay-bin

gtid_mode                     = ON
enforce_gtid_consistency      = ON
log_slave_updates             = ON

# ---- 从库只读 ----
# 注意：read_only 对拥有 SUPER 权限的账号无效，root 仍能写。
# 生产环境应该再加 super_read_only=ON，这里保留 root 的写入能力方便验证
read_only            = ON

character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci
default-time-zone    = '+08:00'

innodb_buffer_pool_size = 64M
max_connections      = 100
