<?xml version="1.0" encoding="UTF-8"?>
<!--
  构建阶段专用的 Maven 配置，由 Dockerfile COPY 到 /root/.m2/settings.xml。

  为什么需要它：容器内直连 repo.maven.apache.org 在国内环境下会超时，
  或因为容器 DNS 回退到 8.8.8.8 而直接解析失败，报错形如：
      Could not transfer artifact ... from/to central:
      repo.maven.apache.org: Temporary failure in name resolution

  把 central 指向阿里云公共仓库（它是中央仓库的全量代理）即可绕开。
  mirrorOf 用 central 而不是 *，避免把项目里可能声明的私有仓库也劫持掉。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <mirrors>
    <mirror>
      <id>aliyun-public</id>
      <name>Aliyun Public Repository</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

</settings>
